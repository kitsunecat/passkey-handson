<% if current_user %>
  <p>ログイン中：<strong><%= current_user.email %></strong></p>
  <%= button_to "ログアウト", session_path, method: :delete %>
<% else %>
  <p>パスキーで登録・ログインできる最小構成のアプリです。</p>
  <div class="actions">
    <%= link_to "新規登録", signup_path, class: "button" %>
    <button type="button" id="login-button">パスキーでログイン</button>
  </div>

  <h2>メールアドレスを入力してログイン</h2>
  <p class="hint">ユーザーネームファースト：先にユーザーを特定し、そのユーザーのパスキーだけで認証します</p>
  <form id="username-first-form">
    <label for="email">メールアドレス</label>
    <input type="email" id="email" name="email" required autocomplete="username">
    <button type="submit">次へ（パスキーで認証）</button>
  </form>
<% end %>
