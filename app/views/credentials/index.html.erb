<h2>パスキーの管理（<%= @credentials.size %> / <%= Credential::MAX_PER_USER %>）</h2>

<table class="credentials">
  <thead>
    <tr><th>名前</th><th>登録日時</th><th>AAGUID</th><th></th></tr>
  </thead>
  <tbody>
    <% @credentials.each do |credential| %>
      <tr>
        <td>
          <%= form_with model: credential, class: "inline" do |f| %>
            <%= f.text_field :nickname, required: true, maxlength: 50, aria: { label: "パスキーの名前" } %>
            <%= f.submit "変更" %>
          <% end %>
        </td>
        <td><%= credential.created_at.strftime("%Y-%m-%d %H:%M") %></td>
        <td><code title="<%= credential.aaguid %>"><%= credential.aaguid.to_s.first(8) %>…</code></td>
        <td>
          <%= button_to "削除", credential_path(credential), method: :delete, class: "danger",
                disabled: @credentials.size <= 1, title: (@credentials.size <= 1 ? "最後のパスキーは削除できません" : nil) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="actions">
  <button type="button" id="add-credential-button" <%= "disabled" if @credentials.size >= Credential::MAX_PER_USER %>>パスキーを追加</button>
  <%= link_to "トップへ戻る", root_path %>
</div>
